{
  "name": "tempo",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter @tempo/web dev",
    "build": "pnpm --filter @tempo/web build",
    "lint": "pnpm --filter @tempo/web lint",
    "typecheck": "pnpm --filter @tempo/shared exec tsc --noEmit && pnpm --filter @tempo/web exec tsc --noEmit && pnpm exec tsc --project convex/tsconfig.json --noEmit",
    "convex:dev": "convex dev",
    "convex:codegen": "convex dev --once"
  },
  "dependencies": {
    "convex": "^1.42.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "typescript": "^5.9.2"
  }
}
